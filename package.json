{
    "name": "@lucania/lucid",
    "version": "1.0.0",
    "description": "A TypeScript/JavaScript engine made for creating 3D applications in your browser.",
    "type": "module",
    "main": "./build/index.js",
    "files": [
        "./build/**/*"
    ],
    "scripts": {
        "setup": "npm install",
        "clean": "erase /F /S /Q build",
        "build": "npx rollup --bundleConfigAsCjs --config rollup.config.js",
        "build:clean": "npm run clean && npm run build",
        "build:watch": "npx rollup --watch --bundleConfigAsCjs --config rollup.config.js",
        "push": "npm run build:clean && npm publish --access public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucania-software/vectorics.git"
    },
    "keywords": [
        "Linear",
        "Algebra",
        "Matrix",
        "Vector"
    ],
    "author": "Jeremy Bankes",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/lucania-software/vectorics/issues"
    },
    "homepage": "https://github.com/lucania-software/vectorics#readme",
    "devDependencies": {
        "@eslint/create-config": "1.9.x",
        "@eslint/js": "9.28.x",
        "@rollup/plugin-babel": "6.0.x",
        "@rollup/plugin-commonjs": "28.0.x",
        "@rollup/plugin-node-resolve": "16.0.x",
        "@rollup/plugin-replace": "6.0.x",
        "@rollup/plugin-typescript": "12.1.x",
        "@stylistic/eslint-plugin": "4.4.x",
        "@types/express": "5.0.x",
        "@webgpu/types": "0.1.x",
        "eslint": "9.28.x",
        "nodemon": "3.1.x",
        "rollup": "4.41.x",
        "rollup-plugin-string": "^3.0.0",
        "tslib": "2.8.x",
        "typescript": "5.8.x",
        "typescript-eslint": "8.33.x"
    },
    "peerDependencies": {
        "@lucania/lumina": "1.0.x",
        "@lucania/toolbox": "1.4.x",
        "@lucania/vectorics": "1.0.x"
    }
}